{
  "name": "growlocal",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["shared", "server", "client"],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm --workspace=server run dev\" \"npm --workspace=client run dev\"",
    "db:push": "npm --workspace=server run db:push",
    "db:seed": "npm --workspace=server run db:seed",
    "test": "npm --workspace=server run test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2"
  }
}
